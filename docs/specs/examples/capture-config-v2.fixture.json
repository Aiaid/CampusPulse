{
  "capture_config_id": "demo-capture-address-v2",
  "node_id": "cp-demo-01",
  "placement_id": "demo-placement-01",
  "dataset": "demo",
  "capture_profile": "address_metrics",
  "allowed_streams": [
    "ble_windows",
    "address_summaries",
    "node_status"
  ],
  "scan": {
    "stack": "nimble",
    "adapter_version": "cp-nimble-v2",
    "mode": "passive",
    "interval_ms": 100,
    "window_ms": 80,
    "filter_duplicates": false,
    "host_filter": "none"
  },
  "raw_capture": {
    "mode": "off"
  },
  "identity_scheme": "mac",
  "accept_until": "2026-10-30T04:00:00.000Z",
  "upload_policy": {
    "max_items": 16,
    "max_body_bytes": 8192,
    "flush_max_age_ms": 1000,
    "warn_pct": 60,
    "raw_pause_pct": 80,
    "critical_pct": 95,
    "resume_pct": 40,
    "overload_action": "pause_raw"
  },
  "protocol": "campuspulse/2",
  "summary": {
    "window_ms": 30000,
    "bin_ms": 5000,
    "max_addresses": 64
  },
  "control": {
    "lease_ms": 120000
  }
}
