menu "Waveshare raw experimental adapters"
config RAW_USB_PROVISION_V2
    bool "Enable experimental existing-v2 USB provisioning after RAW STOP"
    default n
    select MBEDTLS_HAVE_TIME
    select MBEDTLS_HAVE_TIME_DATE
    select MBEDTLS_CERTIFICATE_BUNDLE
    help
        Disabled by default. Bind the existing physical-USB v2 settings flow
        only after an explicit long BOOT or framed begin safely stops recording.
        Network validation and local NVS save run on a separate worker.
        Boot never auto-connects; no TF upload, v3 mode or cloud activation is
        implemented. Battery/display and recording remain on their own paths.
endmenu
