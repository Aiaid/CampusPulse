# --- Target: Waveshare ESP32-S3-ePaper-1.54 V2 (ESP32-S3-PICO-1-N8R8) ---
CONFIG_IDF_TARGET="esp32s3"

# --- Flash: 8 MB DIO, matching the confirmed Arduino test build ---
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Fixed 8 MB image header; only separate images are delivered.
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- PSRAM: 8 MB OPI on this module ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- Console: native USB Serial/JTAG (also the USB setup transport) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- System ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE (canonical passive collection) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# Provisioning uses Security 2 only; no Security 0/1 downgrade exists.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y

# --- HTTPS upload requires certificate and date validation ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Observer does not pair; disable unused NimBLE security manager.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n

# Security 2 SRP arithmetic uses the NimBLE host stack; validate on hardware.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
# Pinned SDK DEBUG logs contain PIN/SRP session material: never compile them.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
