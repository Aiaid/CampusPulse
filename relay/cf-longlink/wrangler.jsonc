{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "campuspulse-link-probe",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "pulse-linktest.anend.net", "custom_domain": true }],
  "observability": { "enabled": false },
  "secrets": { "required": ["PROBE_TOKEN"] }
}
